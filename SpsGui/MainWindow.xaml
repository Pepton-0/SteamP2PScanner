<Window x:Class="SpsGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpsGui"
        mc:Ignorable="d"
        Title="SteamP2PScanner - DNS Ping UI Test" Height="520" Width="860"
        MinHeight="480" MinWidth="760">
    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1F2937" Padding="18,14">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="DNS Ping UI Test" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Dispatcher responsiveness and background DNS measurement" Foreground="#CBD5E1" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="UiHeartbeatDot" Width="12" Height="12" Fill="#22C55E" Margin="0,0,8,0" />
                    <TextBlock x:Name="UiHeartbeatText" Foreground="White" VerticalAlignment="Center" Text="UI alive" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel>
                    <TextBlock Text="Controls" FontSize="18" FontWeight="SemiBold" Foreground="#111827" />

                    <TextBlock Text="DNS service" Margin="0,18,0,6" Foreground="#374151" />
                    <ComboBox x:Name="DnsServiceComboBox" SelectedIndex="0">
                        <ComboBoxItem Tag="1.1.1.1" Content="Cloudflare 1.1.1.1" />
                        <ComboBoxItem Tag="8.8.8.8" Content="Google 8.8.8.8" />
                        <ComboBoxItem Tag="9.9.9.9" Content="Quad9 9.9.9.9" />
                    </ComboBox>

                    <TextBlock Text="Query name" Margin="0,14,0,6" Foreground="#374151" />
                    <ComboBox x:Name="QueryNameComboBox" SelectedIndex="0" IsEditable="True">
                        <ComboBoxItem Content="example.com" />
                        <ComboBoxItem Content="cloudflare.com" />
                        <ComboBoxItem Content="google.com" />
                        <ComboBoxItem Content="quad9.net" />
                    </ComboBox>

                    <TextBlock Text="Interval / timeout" Margin="0,14,0,6" Foreground="#374151" />
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Interval ms" FontSize="12" Foreground="#6B7280" />
                            <TextBox x:Name="DelayTextBox" Text="1000" />
                        </StackPanel>
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Timeout ms" FontSize="12" Foreground="#6B7280" />
                            <TextBox x:Name="PatienceTextBox" Text="3000" />
                        </StackPanel>
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,18,0,0">
                        <Button x:Name="StartButton" Content="Start" Height="34" Margin="0,0,6,0" Click="StartButton_Click" />
                        <Button x:Name="StopButton" Content="Stop" Height="34" Margin="6,0,0,0" Click="StopButton_Click" IsEnabled="False" />
                    </UniformGrid>

                    <Button x:Name="UiStressButton" Content="Run UI Stress 500ms" Height="34" Margin="0,10,0,0" Click="UiStressButton_Click" />

                    <Separator Margin="0,18" />

                    <TextBlock Text="State" FontSize="18" FontWeight="SemiBold" Foreground="#111827" />
                    <TextBlock x:Name="StateTextBlock" Text="Stopped" Margin="0,8,0,0" Foreground="#374151" TextWrapping="Wrap" />
                    <TextBlock x:Name="ThreadTextBlock" Text="UI thread: -" Margin="0,8,0,0" Foreground="#6B7280" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="6" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="4">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Latest" Foreground="#6B7280" />
                            <TextBlock x:Name="LatestPingTextBlock" Text="-" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Average" Foreground="#6B7280" />
                            <TextBlock x:Name="AveragePingTextBlock" Text="-" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Success / Loss" Foreground="#6B7280" />
                            <TextBlock x:Name="CountTextBlock" Text="0 / 0" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Max UI delay" Foreground="#6B7280" />
                            <TextBlock x:Name="MaxUiDelayTextBlock" Text="0 ms" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                    </UniformGrid>

                    <Grid Grid.Row="1" Margin="0,18,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="ActivityProgressBar" Height="12" Minimum="0" Maximum="100" Value="0" />
                        <TextBlock x:Name="DispatcherLagTextBlock" Grid.Column="1" Margin="12,0,0,0" Text="Dispatcher lag: 0 ms" VerticalAlignment="Center" />
                    </Grid>

                    <TextBox x:Name="LogTextBox"
                             Grid.Row="2"
                             FontFamily="Consolas"
                             FontSize="12"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Margin="18,0,18,14" Foreground="#6B7280"
                   Text="This screen intentionally polls DnsPing from the Dispatcher thread to detect UI freezes and cross-thread issues." />
    </Grid>
</Window>
