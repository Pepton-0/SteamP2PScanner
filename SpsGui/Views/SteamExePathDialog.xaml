<mah:MetroWindow x:Class="SpsGui.Views.SteamExePathDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="{StaticResource SteamExePathDialogTitle}"
                 Width="620"
                 Height="190"
                 MinWidth="520"
                 MinHeight="170"
                 WindowStartupLocation="CenterOwner"
                 GlowBrush="#C53A4C"
                 ShowCloseButton="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{StaticResource SteamExePathDialogMessage}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <TextBox x:Name="SteamExePathTextBox"
                 Grid.Row="1"
                 TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto"
                 TextChanged="SteamExePathTextBox_TextChanged" />

        <TextBlock x:Name="ValidationTextBlock"
                   Grid.Row="2"
                   Foreground="#C53A4C"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />

        <Button x:Name="SaveButton"
                Grid.Row="3"
                Content="{StaticResource SteamExePathSaveButton}"
                Width="92"
                HorizontalAlignment="Right"
                IsDefault="True"
                Click="SaveButton_Click" />
    </Grid>
</mah:MetroWindow>
