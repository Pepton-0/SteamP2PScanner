<UserControl x:Class="SpsGui.Views.ProfileScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SpsGui.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProfileScreenViewModel}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{Binding TargetName}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ProcessPath}"
                       FontFamily="Consolas"
                       Foreground="#C8C8C8"
                       Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="{StaticResource CurrentPingTab}">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="SteamAppId" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SteamAppId}" FontFamily="Consolas" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="PID" Margin="0,10,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProcessId}" FontFamily="Consolas" Margin="0,10,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="HWND" Margin="0,10,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WindowHandle}" FontFamily="Consolas" Margin="0,10,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Path" Margin="0,10,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProcessPath}" FontFamily="Consolas" Margin="0,10,0,0" TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <TabItem Header="{StaticResource HistoryPingTab}">
                <Grid Margin="14">
                    <TextBlock Text="{StaticResource HistoryPlaceholder}"
                               Foreground="#C8C8C8" />
                </Grid>
            </TabItem>

            <TabItem Header="{StaticResource ConfigTab}">
                <Grid Margin="14" MaxWidth="620" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="{StaticResource ShowBoxPlotLabel}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center" />
                    <mah:ToggleSwitch Grid.Row="0"
                                      Grid.Column="1"
                                      IsOn="{Binding ShowBoxPlot, Mode=TwoWay}"
                                      HorizontalAlignment="Right"
                                      OnContent=""
                                      OffContent="" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
