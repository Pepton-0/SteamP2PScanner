<UserControl x:Class="SpsGui.Views.ProfileScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SpsGui.Views.Controls"
             xmlns:vm="clr-namespace:SpsGui.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProfileScreenViewModel}">
    <Grid Margin="18">
        <Grid.Resources>
            <Style x:Key="CellTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="AverageTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
                <Setter Property="Foreground" Value="#22C55E" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
            <Style x:Key="LossTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
                <Setter Property="Foreground" Value="#EF4444" />
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
            <DataTemplate x:Key="AverageCellTemplate">
                <TextBlock Text="{Binding AverageText}" Style="{StaticResource AverageTextStyle}" />
            </DataTemplate>
            <DataTemplate x:Key="LossCellTemplate">
                <TextBlock Text="{Binding LossText}" Style="{StaticResource LossTextStyle}" />
            </DataTemplate>
            <DataTemplate x:Key="RelayCellTemplate">
                <TextBlock Text="{Binding UsingRelayText}"
                           Style="{StaticResource CellTextStyle}"
                           Visibility="{Binding UsingRelayVisibility}" />
            </DataTemplate>
            <DataTemplate x:Key="DnsCellTemplate">
                <TextBlock Text="{Binding UsingDnsText}"
                           Style="{StaticResource CellTextStyle}"
                           Visibility="{Binding UsingDnsVisibility}" />
            </DataTemplate>
            <DataTemplate x:Key="BoxPlotCellTemplate">
                <controls:BoxPlotControl Height="52"
                                         Minimum="{Binding Min}"
                                         FirstQuartile="{Binding Q1}"
                                         Median="{Binding Med}"
                                         ThirdQuartile="{Binding Q3}"
                                         Maximum="{Binding Max}" />
            </DataTemplate>
            <DataTemplate x:Key="BarChartCellTemplate">
                <controls:BarChartControl Height="52"
                                          Samples="{Binding RecentPings}"
                                          Average="{Binding Avg}" />
            </DataTemplate>
            <DataTemplate x:Key="ArchiveButtonCellTemplate">
                <Button Content="{StaticResource ArchiveButton}"
                        MinWidth="72"
                        Command="{Binding DataContext.ExportArchiveCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                        CommandParameter="{Binding}" />
            </DataTemplate>
        </Grid.Resources>

        <TabControl Margin="0,-10,0,0">
            <TabItem Header="{StaticResource CurrentPingTab}">
                <ListView ItemsSource="{Binding CurrentProfiles}"
                          Margin="0,6,0,0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{StaticResource PingNameHeader}" Width="180" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="{StaticResource PingAverageHeader}" Width="64" CellTemplate="{StaticResource AverageCellTemplate}" />
                            <GridViewColumn Header="{StaticResource PingLossHeader}" Width="72" CellTemplate="{StaticResource LossCellTemplate}" />
                            <GridViewColumn Header="{StaticResource PingRelayHeader}" Width="82" CellTemplate="{StaticResource RelayCellTemplate}" />
                            <GridViewColumn Header="{StaticResource PingDnsHeader}" Width="64" CellTemplate="{StaticResource DnsCellTemplate}" />
                            <GridViewColumn Header="{StaticResource PingBoxPlotHeader}" Width="270" CellTemplate="{StaticResource BoxPlotCellTemplate}" />
                            <GridViewColumn Header="{StaticResource PingChartHeader}" Width="220" CellTemplate="{StaticResource BarChartCellTemplate}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>

            <TabItem Header="{StaticResource HistoryPingTab}">
                <ListView ItemsSource="{Binding HistoryProfiles}"
                          Margin="0,6,0,0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{StaticResource PingStartedAtHeader}" Width="80" DisplayMemberBinding="{Binding StartedAtText}" />
                            <GridViewColumn Header="{StaticResource ArchiveHeader}" Width="92" CellTemplate="{StaticResource ArchiveButtonCellTemplate}" />
                            <GridViewColumn Header="{StaticResource PingNameHeader}" Width="170" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="{StaticResource PingSteamIdHeader}" Width="150" DisplayMemberBinding="{Binding SteamIDText}" />
                            <GridViewColumn Header="{StaticResource PingAverageHeader}" Width="64" CellTemplate="{StaticResource AverageCellTemplate}" />
                            <GridViewColumn Header="{StaticResource PingLossHeader}" Width="72" CellTemplate="{StaticResource LossCellTemplate}" />
                            <GridViewColumn Header="{StaticResource PingBoxPlotHeader}" Width="250" CellTemplate="{StaticResource BoxPlotCellTemplate}" />
                            <GridViewColumn Header="{StaticResource PingChartHeader}" Width="200" CellTemplate="{StaticResource BarChartCellTemplate}" />
                            <GridViewColumn Header="{StaticResource PingRelayHeader}" Width="82" CellTemplate="{StaticResource RelayCellTemplate}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>

            <TabItem Header="{StaticResource ConfigTab}">
                <Grid Margin="14" MaxWidth="620" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="{StaticResource OverlayEnabledLabel}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center" />
                    <mah:ToggleSwitch Grid.Row="0"
                                      Grid.Column="1"
                                      IsOn="{Binding OverlayEnabled, Mode=TwoWay}"
                                      HorizontalAlignment="Right"
                                      OnContent=""
                                      OffContent="" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="{StaticResource OverlayShowNameLabel}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="0,8,0,0" />
                    <mah:ToggleSwitch Grid.Row="1"
                                      Grid.Column="1"
                                      IsOn="{Binding OverlayShowName, Mode=TwoWay}"
                                      HorizontalAlignment="Right"
                                      Margin="0,8,0,0"
                                      OnContent=""
                                      OffContent="" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="{StaticResource OverlayShowStatusLabel}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="0,8,0,0" />
                    <mah:ToggleSwitch Grid.Row="2"
                                      Grid.Column="1"
                                      IsOn="{Binding OverlayShowStatus, Mode=TwoWay}"
                                      HorizontalAlignment="Right"
                                      Margin="0,8,0,0"
                                      OnContent=""
                                      OffContent="" />

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Text="{StaticResource OverlayShowAverageLabel}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="0,8,0,0" />
                    <mah:ToggleSwitch Grid.Row="3"
                                      Grid.Column="1"
                                      IsOn="{Binding OverlayShowAverage, Mode=TwoWay}"
                                      HorizontalAlignment="Right"
                                      Margin="0,8,0,0"
                                      OnContent=""
                                      OffContent="" />

                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Text="{StaticResource OverlayShowLossLabel}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="0,8,0,0" />
                    <mah:ToggleSwitch Grid.Row="4"
                                      Grid.Column="1"
                                      IsOn="{Binding OverlayShowLoss, Mode=TwoWay}"
                                      HorizontalAlignment="Right"
                                      Margin="0,8,0,0"
                                      OnContent=""
                                      OffContent="" />

                    <TextBlock Grid.Row="5"
                               Grid.Column="0"
                               Text="{StaticResource ShowBoxPlotLabel}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="0,8,0,0" />
                    <mah:ToggleSwitch Grid.Row="5"
                                      Grid.Column="1"
                                      IsOn="{Binding OverlayShowBoxPlot, Mode=TwoWay}"
                                      HorizontalAlignment="Right"
                                      Margin="0,8,0,0"
                                      OnContent=""
                                      OffContent="" />

                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               Text="{StaticResource OverlayShowChartLabel}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="0,8,0,0" />
                    <mah:ToggleSwitch Grid.Row="6"
                                      Grid.Column="1"
                                      IsOn="{Binding OverlayShowChart, Mode=TwoWay}"
                                      HorizontalAlignment="Right"
                                      Margin="0,8,0,0"
                                      OnContent=""
                                      OffContent="" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
