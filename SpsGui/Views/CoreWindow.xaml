<mah:MetroWindow x:Class="SpsGui.Views.CoreWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:behaviors="clr-namespace:SpsGui.Behaviors"
                 xmlns:views="clr-namespace:SpsGui.Views"
                 xmlns:vm="clr-namespace:SpsGui.ViewModels"
                 mc:Ignorable="d"
                 behaviors:IocHelper.AutoViewModel="{x:Type vm:CoreWindowViewModel}"
                 d:DataContext="{d:DesignInstance vm:CoreWindowViewModel}"
                 Title="{Binding ApplicationTitle}"
                 Width="1080"
                 Height="680"
                 MinWidth="920"
                 MinHeight="560"
                 GlowBrush="#C53A4C"
                 WindowStyle="None"
                 ShowTitleBar="True"
                 ResizeMode="CanResizeWithGrip"
                 WindowStartupLocation="CenterScreen">
    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>
            <TextBlock Text="Capture"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#C8C8C8" />
            <TextBlock Text="Overlay"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#C8C8C8" />
            <TextBlock Text="Config"
                       Margin="12,0,12,0"
                       VerticalAlignment="Center"
                       Foreground="#C8C8C8" />
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>

    <mah:MetroWindow.Resources>
        <DataTemplate DataType="{x:Type vm:InitialScreenViewModel}">
            <views:InitialScreen />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileScreenViewModel}">
            <views:ProfileScreen />
        </DataTemplate>
    </mah:MetroWindow.Resources>

    <ContentControl Content="{Binding CurrentViewModel}" />
</mah:MetroWindow>
