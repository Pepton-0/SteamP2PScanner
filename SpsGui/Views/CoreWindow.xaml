<mah:MetroWindow x:Class="SpsGui.Views.CoreWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                 xmlns:behaviors="clr-namespace:SpsGui.Behaviors"
                 xmlns:views="clr-namespace:SpsGui.Views"
                 xmlns:vm="clr-namespace:SpsGui.ViewModels"
                 mc:Ignorable="d"
                 behaviors:IocHelper.AutoViewModel="{x:Type vm:CoreWindowViewModel}"
                 d:DataContext="{d:DesignInstance vm:CoreWindowViewModel}"
                 Title="{Binding ApplicationTitle}"
                 Width="850"
                 Height="300"
                 MinWidth="600"
                 MinHeight="300"
                 GlowBrush="#C53A4C"
                 WindowStyle="None"
                 ShowTitleBar="True"
                 ResizeMode="CanResizeWithGrip"
                 WindowStartupLocation="CenterScreen">
    <i:Interaction.Behaviors>
        <behaviors:CoreWindowPlacementBehavior />
    </i:Interaction.Behaviors>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding ExitCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>
            <TextBlock Text="{Binding CurrentProcessName}"
                       Margin="12,0,12,0"
                       VerticalAlignment="Center"
                       Foreground="#C8C8C8"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="220" />
            <!--
            <Button Command="{Binding TestCommand}" Content="Test"/>-->
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>

    <mah:MetroWindow.Resources>
        <DataTemplate DataType="{x:Type vm:InitialScreenViewModel}">
            <views:InitialScreen />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileScreenViewModel}">
            <views:ProfileScreen />
        </DataTemplate>
    </mah:MetroWindow.Resources>

    <ContentControl Content="{Binding CurrentViewModel}" />
</mah:MetroWindow>
