<Window x:Class="SpsGui.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:SpsGui.Behaviors"
        xmlns:controls="clr-namespace:SpsGui.Views.Controls"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title="SteamP2PScanner Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Topmost="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        IsHitTestVisible="False">
    <i:Interaction.Behaviors>
        <behaviors:OverlayWindowBehavior TargetWindowInfo="{Binding TargetWindowInfo}"
                                         IsOverlayEnabled="{Binding OverlayEnabled}" />
    </i:Interaction.Behaviors>

    <Window.Resources>
        <DropShadowEffect x:Key="OverlayShadowEffect"
                          Color="Black"
                          BlurRadius="2"
                          ShadowDepth="0"
                          Opacity="0.65" />
        <Style x:Key="OverlayCellTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Effect" Value="{StaticResource OverlayShadowEffect}" />
        </Style>
        <Style x:Key="OverlayAverageTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OverlayCellTextStyle}">
            <Setter Property="Foreground" Value="#22C55E" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="OverlayLossTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OverlayCellTextStyle}">
            <Setter Property="Foreground" Value="#EF4444" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="OverlayTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OverlayCellTextStyle}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <Border Background="Transparent"
            Padding="8"
            CornerRadius="0">
        <Grid>
            <TextBlock Text="{Binding ApplicationTitle}"
                       Style="{StaticResource OverlayTitleTextStyle}"
                       Visibility="{Binding EmptyTitleVisibility}" />
            <ItemsControl ItemsSource="{Binding Profiles}"
                          Visibility="{Binding TableVisibility}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}"
                                       Width="150"
                                       Margin="0,0,8,0"
                                       Style="{StaticResource OverlayCellTextStyle}"
                                       Visibility="{Binding DataContext.ShowNameVisibility, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            <TextBlock Text="{Binding StatusText}"
                                       Width="70"
                                       Margin="0,0,8,0"
                                       Style="{StaticResource OverlayCellTextStyle}"
                                       Visibility="{Binding DataContext.ShowStatusVisibility, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            <TextBlock Text="{Binding AverageText}"
                                       Width="48"
                                       Margin="0,0,8,0"
                                       Style="{StaticResource OverlayAverageTextStyle}"
                                       Visibility="{Binding DataContext.ShowAverageVisibility, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            <TextBlock Text="{Binding LossText}"
                                       Width="68"
                                       Margin="0,0,8,0"
                                       Style="{StaticResource OverlayLossTextStyle}"
                                       Visibility="{Binding DataContext.ShowLossVisibility, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            <controls:BoxPlotControl Width="220"
                                                     Height="44"
                                                     Margin="0,0,8,0"
                                                     Effect="{StaticResource OverlayShadowEffect}"
                                                     Minimum="{Binding Min}"
                                                     FirstQuartile="{Binding Q1}"
                                                     Median="{Binding Med}"
                                                     ThirdQuartile="{Binding Q3}"
                                                     Maximum="{Binding Max}"
                                                     Visibility="{Binding DataContext.ShowBoxPlotVisibility, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            <controls:BarChartControl Width="180"
                                                      Height="44"
                                                      Effect="{StaticResource OverlayShadowEffect}"
                                                      Samples="{Binding RecentPings}"
                                                      Average="{Binding Avg}"
                                                      Visibility="{Binding DataContext.ShowChartVisibility, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
