<Window x:Class="SpsGui.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:SpsGui.Behaviors"
        xmlns:controls="clr-namespace:SpsGui.Views.Controls"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title="SteamP2PScanner Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Topmost="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        IsHitTestVisible="False">
    <i:Interaction.Behaviors>
        <behaviors:OverlayWindowBehavior TargetWindowInfo="{Binding TargetWindowInfo}"
                                         IsOverlayEnabled="{Binding OverlayEnabled}"
                                         OffsetX="{Binding OverlayOffsetX}"
                                         OffsetY="{Binding OverlayOffsetY}" />
    </i:Interaction.Behaviors>

    <Window.Resources>
        <DropShadowEffect x:Key="OverlayShadowEffect"
                          Color="Black"
                          BlurRadius="2"
                          ShadowDepth="0"
                          Opacity="0.65" />
        <Style x:Key="OverlayCellTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Effect" Value="{StaticResource OverlayShadowEffect}" />
        </Style>
        <Style x:Key="OverlayAverageTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OverlayCellTextStyle}">
            <Setter Property="Foreground" Value="#22C55E" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="OverlayLossTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OverlayCellTextStyle}">
            <Setter Property="Foreground" Value="#EF4444" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="OverlayTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OverlayCellTextStyle}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <Border Background="Transparent"
            Padding="8"
            CornerRadius="0">
        <Grid>
            <TextBlock Text="{Binding ApplicationTitle, Mode=OneWay}"
                       Style="{StaticResource OverlayTitleTextStyle}"
                       Visibility="{Binding EmptyTitleVisibility, Mode=OneWay}" />
            <ItemsControl ItemsSource="{Binding Profiles, Mode=OneWay}"
                          HorizontalAlignment="Right"
                          Grid.IsSharedSizeScope="True"
                          Visibility="{Binding TableVisibility, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="OverlayNameColumn" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                       Grid.Column="0"
                                       Width="40"
                                       Margin="0,0,8,0"
                                       Style="{StaticResource OverlayCellTextStyle}"
                                       Visibility="{Binding DataContext.ShowStatusVisibility, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" />
                            <TextBlock Text="{Binding Name, Mode=OneWay}"
                                       Grid.Column="1"
                                       Margin="0,0,8,0"
                                       Style="{StaticResource OverlayCellTextStyle}"
                                       Visibility="{Binding DataContext.ShowNameVisibility, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" />
                            <TextBlock Text="{Binding AverageText, Mode=OneWay}"
                                       Grid.Column="2"
                                       Width="30"
                                       Margin="0,0,8,0"
                                       Style="{StaticResource OverlayAverageTextStyle}"
                                       Visibility="{Binding DataContext.ShowAverageVisibility, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" />
                            <TextBlock Text="{Binding LossText, Mode=OneWay}"
                                       Grid.Column="3"
                                       Width="40"
                                       Margin="0,0,8,0"
                                       Style="{StaticResource OverlayLossTextStyle}"
                                       Visibility="{Binding DataContext.ShowLossVisibility, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" />
                            <controls:BoxPlotControl Width="220"
                                                     Grid.Column="4"
                                                     Height="34"
                                                     Margin="0,0,8,0"
                                                     Effect="{StaticResource OverlayShadowEffect}"
                                                     Origin="{Binding Origin, Mode=OneWay}"
                                                     Minimum="{Binding Min, Mode=OneWay}"
                                                     FirstQuartile="{Binding Q1, Mode=OneWay}"
                                                     Median="{Binding Med, Mode=OneWay}"
                                                     ThirdQuartile="{Binding Q3, Mode=OneWay}"
                                                     Maximum="{Binding Max, Mode=OneWay}"
                                                     Limit="{Binding Limit, Mode=OneWay}"
                                                     Visibility="{Binding DataContext.ShowBoxPlotVisibility, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" />
                            <controls:BarChartControl Width="100"
                                                      Grid.Column="5"
                                                      Height="34"
                                                      Effect="{StaticResource OverlayShadowEffect}"
                                                      Samples="{Binding RecentPings, Mode=OneWay}"
                                                      Average="{Binding Avg, Mode=OneWay}"
                                                      Visibility="{Binding DataContext.ShowChartVisibility, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
