<Window x:Class="SpsGui.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:SpsGui.Behaviors"
        xmlns:controls="clr-namespace:SpsGui.Views.Controls"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:logic="clr-namespace:SpsLogic;assembly=SpsLogic"
        Title="SteamP2PScanner Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Topmost="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        IsHitTestVisible="False">
    <i:Interaction.Behaviors>
        <behaviors:OverlayWindowBehavior TargetWindowInfo="{Binding TargetWindowInfo}"
                                         IsOverlayEnabled="{Binding OverlayEnabled}"
                                         OffsetX="{Binding OverlayOffsetX}"
                                         OffsetY="{Binding OverlayOffsetY}" />
    </i:Interaction.Behaviors>

    <Window.Resources>
        <controls:BoolToAnyVisibilityConverter x:Key="VisibleIfTrueConverter"
                                               TrueTo="Visible"
                                               FalseTo="Collapsed" />
        <DropShadowEffect x:Key="OverlayShadowEffect"
                          Color="Black"
                          BlurRadius="2"
                          ShadowDepth="0"
                          Opacity="0.65" />
        <Style x:Key="OverlayCellTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Effect" Value="{StaticResource OverlayShadowEffect}" />
        </Style>
        <Style x:Key="OverlayAverageTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OverlayCellTextStyle}">
            <Setter Property="Foreground" Value="#22C55E" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="OverlayLossTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OverlayCellTextStyle}">
            <Setter Property="Foreground" Value="#EF4444" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="OverlayTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource OverlayCellTextStyle}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="OverlayDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverlayDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <DataGridCellsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverlayDataGridRowHeaderStyle" TargetType="DataGridRowHeader">
            <Setter Property="Width" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Window.Resources>

    <Border Background="Transparent"
            Padding="8"
            CornerRadius="0">
        <Grid>
            <TextBlock Text="{Binding ApplicationTitle, Mode=OneWay}"
                       Style="{StaticResource OverlayTitleTextStyle}"
                       Visibility="{Binding EmptyTitleVisibility, Mode=OneWay}" />
            <DataGrid ItemsSource="{Binding Profiles, Mode=OneWay}"
                      HorizontalAlignment="Right"
                      Visibility="{Binding TableVisibility, Mode=OneWay}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="None"
                      GridLinesVisibility="None"
                      Background="Transparent"
                      RowBackground="Transparent"
                      AlternatingRowBackground="Transparent"
                      BorderThickness="0"
                      BorderBrush="Transparent"
                      HorizontalGridLinesBrush="Transparent"
                      VerticalGridLinesBrush="Transparent"
                      RowHeaderWidth="0"
                      ColumnHeaderHeight="0"
                      ColumnWidth="SizeToCells"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="False"
                      IsReadOnly="True"
                      Focusable="False"
                      IsTabStop="False"
                      CellStyle="{StaticResource OverlayDataGridCellStyle}"
                      RowStyle="{StaticResource OverlayDataGridRowStyle}"
                      RowHeaderStyle="{StaticResource OverlayDataGridRowHeaderStyle}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Status"
                                            Width="48"
                                            Visibility="{Binding Source={x:Static logic:AppConfig.Instance}, Path=OverlayShowStatus, Converter={StaticResource VisibleIfTrueConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                           Width="40"
                                           Margin="0,2,8,2"
                                           Style="{StaticResource OverlayCellTextStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Name"
                                            Width="SizeToCells"
                                            Visibility="{Binding Source={x:Static logic:AppConfig.Instance}, Path=OverlayShowName, Converter={StaticResource VisibleIfTrueConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                               TextWrapping="NoWrap"
                                               Style="{StaticResource OverlayCellTextStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Average"
                                            Width="38"
                                            Visibility="{Binding Source={x:Static logic:AppConfig.Instance}, Path=OverlayShowAverage, Converter={StaticResource VisibleIfTrueConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AverageText, Mode=OneWay}"
                                           Width="30"
                                           Margin="0,2,8,2"
                                           Style="{StaticResource OverlayAverageTextStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Loss"
                                            Width="48"
                                            Visibility="{Binding Source={x:Static logic:AppConfig.Instance}, Path=OverlayShowLoss, Converter={StaticResource VisibleIfTrueConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LossText, Mode=OneWay}"
                                           Width="40"
                                           Margin="0,2,8,2"
                                           Style="{StaticResource OverlayLossTextStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="BoxPlot"
                                            Width="228"
                                            Visibility="{Binding Source={x:Static logic:AppConfig.Instance}, Path=ShowBoxPlot, Converter={StaticResource VisibleIfTrueConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:BoxPlotControl Width="220"
                                                         Height="34"
                                                         Margin="0,2,8,2"
                                                         Effect="{StaticResource OverlayShadowEffect}"
                                                         Origin="{Binding Origin, Mode=OneWay}"
                                                         Minimum="{Binding Min, Mode=OneWay}"
                                                         FirstQuartile="{Binding Q1, Mode=OneWay}"
                                                         Median="{Binding Med, Mode=OneWay}"
                                                         ThirdQuartile="{Binding Q3, Mode=OneWay}"
                                                         Maximum="{Binding Max, Mode=OneWay}"
                                                         Limit="{Binding Limit, Mode=OneWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Chart"
                                            Width="100"
                                            Visibility="{Binding Source={x:Static logic:AppConfig.Instance}, Path=OverlayShowChart, Converter={StaticResource VisibleIfTrueConverter}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:BarChartControl Width="100"
                                                          Height="34"
                                                          Margin="0,2,0,2"
                                                          Effect="{StaticResource OverlayShadowEffect}"
                                                          Samples="{Binding RecentPings, Mode=OneWay}"
                                                          Average="{Binding Avg, Mode=OneWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Window>
