<UserControl x:Class="SpsGui.Views.InitialScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SpsGui.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:InitialScreenViewModel}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="{StaticResource SteamExeLabel}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />
            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Text="{Binding SteamExePath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     FontFamily="Consolas" />
            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="{StaticResource AutoIpcLabel}"
                       VerticalAlignment="Center"
                       Margin="0,10,12,0" />
            <CheckBox Grid.Row="1"
                      Grid.Column="1"
                      IsChecked="{Binding AutoIpc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      VerticalAlignment="Center"
                      Margin="0,10,0,0" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="{StaticResource ManualDetectionHeader}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="2"
                            Content="{StaticResource ManualSelectButton}"
                            Command="{Binding ManualSelectCommand}"
                            HorizontalAlignment="Left"
                               Margin="0,16,0,0"
                            FontSize="16"
                            MinWidth="170" />
                    <TextBlock Grid.Row="1"
                               Text="{StaticResource ManualDetectionNote}"
                               TextWrapping="Wrap"
                               Foreground="#C8C8C8" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2"
                      Header="{StaticResource AutoDetectionHeader}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0"
                             ItemsSource="{Binding AutoCandidates}"
                             SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SteamAppCandidateViewModel}">
                                <Grid MinWidth="420" Margin="0,4">
                                    <TextBlock Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Button Command="{Binding MonitorSelectedCommand}"
                                FontSize="16"
                                MinWidth="180"
                                MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                HorizontalAlignment="Right">
                            <TextBlock Text="{Binding MonitorButtonText}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                        </Button>
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
