<Window x:Class="SpsGui.SteamPacketScanTest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpsGui"
        Title="Steam Packet Scan Test"
        Width="1080"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#101820" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#334155" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#B8C2CC" />

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,5" />
        </Style>

        <DataTemplate x:Key="ProfilerRowTemplate" DataType="{x:Type local:PingProfileSnapshot}">
            <Grid MinHeight="52" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="190" SharedSizeGroup="NameColumn" />
                    <ColumnDefinition Width="78" SharedSizeGroup="AverageColumn" />
                    <ColumnDefinition Width="58" SharedSizeGroup="LossColumn" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="128" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding State}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontFamily="Consolas"
                           FontSize="13"
                           Margin="0,0,10,2" />

                <TextBlock Grid.Column="1"
                           Text="{Binding Name}"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,14,2" />

                <TextBlock Grid.Column="2"
                           Text="{Binding AverageText}"
                           Foreground="#22C55E"
                           FontSize="16"
                           HorizontalAlignment="Right"
                           Margin="0,0,14,2" />

                <TextBlock Grid.Column="3"
                           Text="{Binding LossText}"
                           Foreground="#F87171"
                           FontSize="16"
                           HorizontalAlignment="Right"
                           Margin="0,0,8,2" />

                <local:BoxPlotView Grid.Column="4"
                                   Height="46"
                                   Margin="0,0,12,2"
                                   VerticalAlignment="Center"
                                   DataContext="{Binding}" />

                <local:RecentStatsBarsView Grid.Column="5"
                                           Height="46"
                                           Margin="0,0,12,2"
                                           VerticalAlignment="Center"
                                           DataContext="{Binding}" />

                <TextBlock Grid.Column="6"
                           Text="{Binding NetId}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,2" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Game process" Margin="0,0,8,6" />
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Text="{Binding GameProcessName}"
                           FontFamily="Consolas"
                           FontWeight="SemiBold"
                           Margin="0,0,16,6" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Patience ms" Margin="0,0,8,6" />
                <TextBox x:Name="PatienceTextBox"
                         Grid.Row="0"
                         Grid.Column="3"
                         Text="3000"
                         Margin="0,0,16,6"
                         VerticalContentAlignment="Center" />

                <TextBlock Grid.Row="0" Grid.Column="4" Text="Steam log" Margin="0,0,8,6" />
                <TextBlock Grid.Row="0"
                           Grid.Column="5"
                           Text="{Binding SteamLogPath}"
                           FontFamily="Consolas"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,6" />

                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="6"
                            Orientation="Horizontal">
                    <Button Content="Start monitoring" Click="StartButton_Click" />
                    <Button Content="Update now" Click="UpdateButton_Click" />
                    <Button Content="Stop" Click="StopButton_Click" />
                    <CheckBox x:Name="AutoUpdateCheckBox"
                              Content="Auto update"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="6,0,14,6" />
                    <TextBlock x:Name="StateTextBlock"
                               Text="SteamPacketScan: stopped"
                               FontWeight="SemiBold" />
                </StackPanel>

                <TextBlock x:Name="UpdateStatusTextBlock"
                           Grid.Row="2"
                           Grid.Column="0"
                           Grid.ColumnSpan="6"
                           Text="Update: ticks=0, executed=0"
                           FontFamily="Consolas"
                           Margin="0,4,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Steam API" />
                <TextBlock x:Name="SteamApiTextBlock"
                           Grid.Row="0"
                           Grid.Column="1"
                           Text="-"
                           FontFamily="Consolas" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Peers" />
                <TextBlock x:Name="PeerCountTextBlock"
                           Grid.Row="0"
                           Grid.Column="3"
                           Text="0"
                           FontFamily="Consolas" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="PacketScan" />
                <TextBlock x:Name="PacketScanTextBlock"
                           Grid.Row="1"
                           Grid.Column="1"
                           Text="-"
                           FontFamily="Consolas" />

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Last update" />
                <TextBlock x:Name="LastUpdateTextBlock"
                           Grid.Row="1"
                           Grid.Column="3"
                           Text="-"
                           FontFamily="Consolas" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="PacketScan histories"
                           Foreground="{StaticResource TextBrush}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl Grid.IsSharedSizeScope="True"
                                  ItemsSource="{Binding PacketProfiles}"
                                  ItemTemplate="{StaticResource ProfilerRowTemplate}" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="3"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Steam peers"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <ListView ItemsSource="{Binding Peers}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="SteamID" Width="180" DisplayMemberBinding="{Binding SteamIDText}" />
                            <GridViewColumn Header="API" Width="170" DisplayMemberBinding="{Binding ConnectionTypeName}" />
                            <GridViewColumn Header="Route" Width="90" DisplayMemberBinding="{Binding RouteText}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <TextBox x:Name="LogTextBox"
                 Grid.Row="4"
                 FontFamily="Consolas"
                 FontSize="12"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" />
    </Grid>
</Window>
