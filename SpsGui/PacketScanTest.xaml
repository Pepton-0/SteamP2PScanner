<Window x:Class="SpsGui.PacketScanTest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpsGui"
        Title="PacketScan Test"
        Width="980"
        Height="720"
        MinWidth="820"
        MinHeight="560"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,8,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="STUN service" Margin="0,0,8,6" />
                <ComboBox x:Name="ServiceComboBox"
                          Grid.Row="0"
                          Grid.Column="1"
                          IsEditable="True"
                          SelectedIndex="0"
                          SelectionChanged="ServiceComboBox_SelectionChanged">
                    <ComboBoxItem Content="stunserver2025.stunprotocol.org" Tag="3478" />
                    <ComboBoxItem Content="stun.stunprotocol.org" Tag="3478" />
                    <ComboBoxItem Content="stun.l.google.com" Tag="19302" />
                    <ComboBoxItem Content="stun1.l.google.com" Tag="19302" />
                    <ComboBoxItem Content="stun.cloudflare.com" Tag="3478" />
                </ComboBox>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Port" Margin="0,0,8,6" />
                <TextBox x:Name="RemotePortTextBox"
                         Grid.Row="0"
                         Grid.Column="3"
                         Text="3478" />

                <TextBlock Grid.Row="0" Grid.Column="4" Text="Local port" Margin="0,0,8,6" />
                <TextBox x:Name="LocalPortTextBox"
                         Grid.Row="0"
                         Grid.Column="5"
                         Text="0" />

                <TextBlock Grid.Row="0" Grid.Column="6" Text="Patience ms" Margin="0,0,8,6" />
                <TextBox x:Name="PatienceTextBox"
                         Grid.Row="0"
                         Grid.Column="7"
                         Text="3000" />

                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="9"
                            Orientation="Horizontal">
                    <Button Content="Construct" Click="ConstructButton_Click" />
                    <Button Content="Register" Click="RegisterButton_Click" />
                    <Button Content="Unregister" Click="UnregisterButton_Click" />
                    <Button Content="Update" Click="UpdateButton_Click" />
                    <Button Content="Dispose" Click="DisposeButton_Click" />
                    <Button Content="Run lifecycle test" Click="LifecycleButton_Click" />
                    <Button Content="Send classic STUN" Click="SendClassicStunButton_Click" />
                    <CheckBox x:Name="AutoUpdateCheckBox"
                              Content="Auto Update"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="6,0,14,6" />
                    <CheckBox x:Name="RegisterBeforeSendCheckBox"
                              Content="Register before send"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="0,0,14,6" />
                    <TextBlock x:Name="StateTextBlock"
                               Text="PacketScan: not constructed"
                               FontWeight="SemiBold" />
                </StackPanel>

                <TextBlock x:Name="UpdateStatusTextBlock"
                           Grid.Row="2"
                           Grid.Column="0"
                           Grid.ColumnSpan="9"
                           Text="Update: timer ticks=0, auto requests=0, manual requests=0, executed=0"
                           FontFamily="Consolas"
                           Margin="0,4,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Resolved endpoint" />
                <TextBlock x:Name="EndpointTextBlock"
                           Grid.Row="0"
                           Grid.Column="1"
                           Text="-"
                           FontFamily="Consolas" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Opponent netId" />
                <TextBlock x:Name="NetIdTextBlock"
                           Grid.Row="0"
                           Grid.Column="3"
                           Text="-"
                           FontFamily="Consolas" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Dispatcher" />
                <TextBlock x:Name="DispatcherTextBlock"
                           Grid.Row="1"
                           Grid.Column="1"
                           Text="-"
                           FontFamily="Consolas" />

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Last response" />
                <TextBlock x:Name="ResponseTextBlock"
                           Grid.Row="1"
                           Grid.Column="3"
                           Text="-"
                           FontFamily="Consolas" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Active histories"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <ListView ItemsSource="{Binding ActiveHistories}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="State" Width="80" DisplayMemberBinding="{Binding State, Mode=OneWay}" />
                                <GridViewColumn Header="Name" Width="180" DisplayMemberBinding="{Binding Name, Mode=OneWay}" />
                                <GridViewColumn Header="NetId" Width="150" DisplayMemberBinding="{Binding NetId, Mode=OneWay}" />
                                <GridViewColumn Header="Avg" Width="80" DisplayMemberBinding="{Binding AverageText, Mode=OneWay}" />
                                <GridViewColumn Header="Loss" Width="80" DisplayMemberBinding="{Binding LossText, Mode=OneWay}" />
                                <GridViewColumn Header="Min" Width="70" DisplayMemberBinding="{Binding MinText, Mode=OneWay}" />
                                <GridViewColumn Header="Q1" Width="70" DisplayMemberBinding="{Binding Q1Text, Mode=OneWay}" />
                                <GridViewColumn Header="Med" Width="70" DisplayMemberBinding="{Binding MedText, Mode=OneWay}" />
                                <GridViewColumn Header="Q3" Width="70" DisplayMemberBinding="{Binding Q3Text, Mode=OneWay}" />
                                <GridViewColumn Header="Max" Width="70" DisplayMemberBinding="{Binding MaxText, Mode=OneWay}" />
                                <GridViewColumn Header="Latest" Width="80" DisplayMemberBinding="{Binding Latest, Mode=OneWay}" />
                                <GridViewColumn Header="Recent" Width="220" DisplayMemberBinding="{Binding Recent, Mode=OneWay}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>

                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Old histories"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <ListView ItemsSource="{Binding OldHistories}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="State" Width="80" DisplayMemberBinding="{Binding State, Mode=OneWay}" />
                                <GridViewColumn Header="Name" Width="180" DisplayMemberBinding="{Binding Name, Mode=OneWay}" />
                                <GridViewColumn Header="NetId" Width="150" DisplayMemberBinding="{Binding NetId, Mode=OneWay}" />
                                <GridViewColumn Header="Avg" Width="80" DisplayMemberBinding="{Binding AverageText, Mode=OneWay}" />
                                <GridViewColumn Header="Loss" Width="80" DisplayMemberBinding="{Binding LossText, Mode=OneWay}" />
                                <GridViewColumn Header="Min" Width="70" DisplayMemberBinding="{Binding MinText, Mode=OneWay}" />
                                <GridViewColumn Header="Q1" Width="70" DisplayMemberBinding="{Binding Q1Text, Mode=OneWay}" />
                                <GridViewColumn Header="Med" Width="70" DisplayMemberBinding="{Binding MedText, Mode=OneWay}" />
                                <GridViewColumn Header="Q3" Width="70" DisplayMemberBinding="{Binding Q3Text, Mode=OneWay}" />
                                <GridViewColumn Header="Max" Width="70" DisplayMemberBinding="{Binding MaxText, Mode=OneWay}" />
                                <GridViewColumn Header="Latest" Width="80" DisplayMemberBinding="{Binding Latest, Mode=OneWay}" />
                                <GridViewColumn Header="Recent" Width="220" DisplayMemberBinding="{Binding Recent, Mode=OneWay}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Grid>
        </Border>

        <TextBox x:Name="LogTextBox"
                 Grid.Row="3"
                 FontFamily="Consolas"
                 FontSize="12"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" />
    </Grid>
</Window>
