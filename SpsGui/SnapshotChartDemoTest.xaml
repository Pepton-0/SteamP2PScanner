<Window x:Class="SpsGui.SnapshotChartDemoTest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SpsGui.Views.Controls"
        xmlns:local="clr-namespace:SpsGui"
        Title="Snapshot Chart Demo Test"
        Width="980"
        Height="360"
        MinWidth="820"
        MinHeight="300">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#101820" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#334155" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#B8C2CC" />

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="SnapshotRowTemplate" DataType="{x:Type local:DemoPingSnapshot}">
            <Grid MinHeight="72" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Name}"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,14,0" />

                <TextBlock Grid.Column="1"
                           Text="{Binding AverageText}"
                           Foreground="#22C55E"
                           FontSize="15"
                           HorizontalAlignment="Right"
                           Margin="0,0,14,0" />

                <TextBlock Grid.Column="2"
                           Text="{Binding LossText}"
                           Foreground="#F87171"
                           FontSize="15"
                           HorizontalAlignment="Right"
                           Margin="0,0,14,0" />

                <controls:BoxPlotControl Grid.Column="3"
                                         Height="58"
                                         Margin="0,0,18,0"
                                         Origin="{Binding Origin}"
                                         Minimum="{Binding Min}"
                                         FirstQuartile="{Binding Q1}"
                                         Median="{Binding Med}"
                                         ThirdQuartile="{Binding Q3}"
                                         Maximum="{Binding Max}"
                                         Limit="{Binding Limit}" />

                <controls:BarChartControl Grid.Column="4"
                                          Height="58"
                                          Samples="{Binding RecentPings}"
                                          Average="{Binding Avg}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#0B1117" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Snapshot chart demo"
                   Foreground="{StaticResource TextBrush}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                Padding="12">
            <ItemsControl ItemsSource="{Binding Snapshots}"
                          ItemTemplate="{StaticResource SnapshotRowTemplate}" />
        </Border>
    </Grid>
</Window>
