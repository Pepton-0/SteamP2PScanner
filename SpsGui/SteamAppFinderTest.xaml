<Window x:Class="SpsGui.SteamAppFinderTest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam App Finder Test"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="620"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,10">
            <TextBlock x:Name="SummaryTextBlock"
                       Text="-"
                       FontFamily="Consolas"
                       HorizontalAlignment="Right" />
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Manual"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <WrapPanel>
                            <Button Content="Manual select" Click="ManualSelectButton_Click" />
                            <Button Content="Refresh" Click="RefreshButton_Click" />
                            <Button Content="Reset finder" Click="ResetFinderButton_Click" />
                        </WrapPanel>
                        <CheckBox x:Name="AutoRefreshCheckBox"
                                  Content="Auto refresh"
                                  IsChecked="True"
                                  Margin="0,0,0,12" />
                    </StackPanel>

                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Detected but hidden from candidates"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <ListView ItemsSource="{Binding HiddenRows}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name, Mode=OneWay}" />
                                    <GridViewColumn Header="SteamAppId" Width="90" DisplayMemberBinding="{Binding SteamAppId, Mode=OneWay}" />
                                    <GridViewColumn Header="PID" Width="70" DisplayMemberBinding="{Binding ProcessId, Mode=OneWay}" />
                                    <GridViewColumn Header="Process" Width="130" DisplayMemberBinding="{Binding ProcessName, Mode=OneWay}" />
                                    <GridViewColumn Header="Path" Width="360" DisplayMemberBinding="{Binding ProcessPath, Mode=OneWay}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Auto detect candidates"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0">
                        <TextBlock x:Name="SelectionStatusTextBlock"
                                   Text="No candidate selected"
                                   Foreground="#57606A"
                                   Margin="0,0,12,8" />
                        <Button x:Name="MonitorButton"
                                Content="Monitor"
                                MinWidth="160"
                                IsEnabled="False"
                                Click="MonitorButton_Click" />
                    </StackPanel>

                    <ListView x:Name="CandidateListView"
                              ItemsSource="{Binding CandidateRows}"
                              SelectionMode="Single"
                              SelectionChanged="CandidateListView_SelectionChanged"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="260" DisplayMemberBinding="{Binding Name, Mode=OneWay}" />
                                <GridViewColumn Header="SteamAppId" Width="100" DisplayMemberBinding="{Binding SteamAppId, Mode=OneWay}" />
                                <GridViewColumn Header="PID" Width="80" DisplayMemberBinding="{Binding ProcessId, Mode=OneWay}" />
                                <GridViewColumn Header="Process" Width="150" DisplayMemberBinding="{Binding ProcessName, Mode=OneWay}" />
                                <GridViewColumn Header="HWND" Width="110" DisplayMemberBinding="{Binding WindowHandle, Mode=OneWay}" />
                                <GridViewColumn Header="Path" Width="460" DisplayMemberBinding="{Binding ProcessPath, Mode=OneWay}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>

        <TextBox x:Name="LogTextBox"
                 Grid.Row="2"
                 FontFamily="Consolas"
                 FontSize="12"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Margin="0,10,0,0" />
    </Grid>
</Window>
